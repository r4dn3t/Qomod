APP_ENV=development
PORT=8083
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=super-secret-development-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=users.events
RABBITMQ_QUEUE=auth.user-events.queue

# Users Service URL
USERS_SERVICE_URL=http://localhost:8081
